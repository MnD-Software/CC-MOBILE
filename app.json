{
  "expo": {
    "name": "Cake City",
    "slug": "cake-city-mobile",
    "scheme": "cakecity",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/cake-city-app-icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF7FB",
    "primaryColor": "#EC008C",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ke.co.cakecity.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSSupportsLiveActivities": true,
        "NSSupportsLiveActivitiesFrequentUpdates": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF7FB",
        "foregroundImage": "./assets/cake-city-icon-foreground.png"
      },
      "versionCode": 1,
      "predictiveBackGestureEnabled": false,
      "package": "ke.co.cakecity.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-google-signin/google-signin",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF7FB",
          "image": "./assets/cake-city-splash.png",
          "imageWidth": 260,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
