{
  "expo": {
    "name": "Cake City",
    "slug": "cakecitymobiledev",
    "scheme": "cakecity",
    "version": "0.2.3",
    "orientation": "portrait",
    "icon": "./assets/cake-city-app-icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FFFEFF",
    "primaryColor": "#EC008C",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ke.co.cakecity.mobile",
      "buildNumber": "16",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF5FA",
        "foregroundImage": "./assets/cake-city-icon-foreground.png"
      },
      "versionCode": 16,
      "predictiveBackGestureEnabled": true,
      "package": "ke.co.cakecity.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cake City uses your selected photo for your profile picture or a custom cake inspiration.",
          "cameraPermission": false,
          "microphonePermission": false,
          "colors": {
            "cropToolbarColor": "#FFF5FA",
            "cropToolbarIconColor": "#B80068",
            "cropToolbarActionTextColor": "#B80068",
            "cropBackButtonIconColor": "#51382D",
            "cropBackgroundColor": "#FFFEFF"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFEFF",
          "image": "./assets/cake-city-splash.png",
          "imageWidth": 260,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cake City uses your location while you are checking out to suggest your delivery address."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#EC008C",
          "defaultChannel": "orders"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "url": "https://u.expo.dev/a656bf20-49d8-41a4-990b-9f3049a57a25",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "useEmbeddedUpdate": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "ke.co.cakecity.mobile.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.ke.co.cakecity.mobile"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "dad0f312-d1c4-4636-bf66-9f813e436509"
      }
    },
    "owner": "marcos_noel23"
  }
}
