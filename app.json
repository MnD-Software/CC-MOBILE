{
  "expo": {
    "name": "Cake City",
    "slug": "cakecitymobiledev",
    "scheme": "cakecity",
    "version": "0.3.3",
    "orientation": "portrait",
    "icon": "./assets/cake-city-app-icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FFFFFF",
    "primaryColor": "#EC008C",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ke.co.cakecity.mobile",
      "buildNumber": "19",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF5FA",
        "foregroundImage": "./assets/cake-city-icon-foreground.png"
      },
      "versionCode": 19,
      "predictiveBackGestureEnabled": true,
      "package": "ke.co.cakecity.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-image",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cake City uses your selected photo for your profile picture or a custom cake inspiration.",
          "cameraPermission": false,
          "microphonePermission": "Cake City uses your microphone only when you record a voice command.",
          "colors": {
            "cropToolbarColor": "#FFF5FA",
            "cropToolbarIconColor": "#B80068",
            "cropToolbarActionTextColor": "#B80068",
            "cropBackButtonIconColor": "#51382D",
            "cropBackgroundColor": "#FFFEFF"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#21051E",
          "image": "./assets/cake-city-splash.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#21051E",
            "image": "./assets/cake-city-splash.png"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cake City uses your location to suggest your delivery address, or to share your position during an assigned delivery when you choose to enable rider tracking.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "Cake City shares your position with your delivery customer while you navigate or lock the phone, only when you enable background sharing for an assigned trip."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#EC008C",
          "defaultChannel": "orders"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "url": "https://u.expo.dev/dad0f312-d1c4-4636-bf66-9f813e436509",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "useEmbeddedUpdate": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "ke.co.cakecity.mobile.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.ke.co.cakecity.mobile"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "dad0f312-d1c4-4636-bf66-9f813e436509"
      }
    },
    "owner": "marcos_noel23"
  }
}
