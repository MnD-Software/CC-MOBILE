{
  "expo": {
    "name": "Cake City",
    "slug": "cakecity",
    "scheme": "cakecity",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/cake-city-app-icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFCFA",
    "primaryColor": "#EC008C",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ke.co.cakecity.mobile",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF7FB",
        "foregroundImage": "./assets/cake-city-icon-foreground.png"
      },
      "versionCode": 2,
      "predictiveBackGestureEnabled": true,
      "package": "ke.co.cakecity.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF7FB",
          "image": "./assets/cake-city-splash.png",
          "imageWidth": 260,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cake City uses your location to find nearby branches and quote delivery to your address."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#EC008C",
          "defaultChannel": "orders"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3bcef2b6-1064-461f-a7e8-620bfc94e13d"
      }
    },
    "owner": "marcosnoel23"
  }
}
