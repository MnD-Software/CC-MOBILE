{
  "cli": {
    "version": ">=16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "preview": {
      "channel": "preview",
      "distribution": "internal",
      "environment": "preview",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "CAKECITY_BUILD_PROFILE": "preview",
        "EXPO_PUBLIC_API_URL": "https://cc-mobile-1.onrender.com"
      }
    },
    "ios-simulator": {
      "extends": "preview",
      "autoIncrement": false,
      "ios": {
        "simulator": true,
        "withoutCredentials": true
      }
    },
    "ios-unsigned-device": {
      "extends": "preview",
      "autoIncrement": false,
      "ios": {
        "simulator": false,
        "withoutCredentials": true,
        "config": "unsigned-device.yml"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "CAKECITY_BUILD_PROFILE": "production",
        "EXPO_PUBLIC_API_URL": "https://cc-mobile-1.onrender.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
