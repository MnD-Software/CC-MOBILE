# Copy to .env.odoo.local in this backend directory. Never commit the API key.
# Activation remains off until the addon, permissions and company setup pass UAT.
ODOO_ENABLED=false
ODOO_URL=https://my.cakecity.co.ke
ODOO_DATABASE=cake-demo
ODOO_API_KEY=
ODOO_COMPANY_ID=0
ODOO_SOURCE_ID=cakecity-demo
ODOO_WEBHOOK_SECRET=
ODOO_LOYALTY_AUTHORITY=false
ODOO_REQUIRE_MAPPED_PRODUCTS=true
ODOO_CATALOGUE_MAX_AGE_SECONDS=300
