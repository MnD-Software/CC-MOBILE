# Render/Neon production values
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/cakecity?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=https://your-web-origin.example
ENVIRONMENT=production
WOOCOMMERCE_STORE_URL=https://cakecity.co.ke/wp-json/wc/store/v1

# Optional tuning
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Optional shared public cache and traffic protection. Required before multi-instance load validation.
REDIS_URL=
# Only set a real provisioned Redis URL; localhost is not a hosted Redis service.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# Club uses verified orders and server-side coupon issuance only.
CLUB_EVENT_SECRET=
WOOCOMMERCE_WEBHOOK_SECRET=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
WOOCOMMERCE_API_URL=https://cakecity.co.ke/wp-json/wc/v3
CLUB_EARN_MINOR=10000
CLUB_POINT_VALUE_MINOR=100
CLUB_EXPIRY_DAYS=365
