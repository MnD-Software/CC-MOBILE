# Separate service only: uvicorn app.payment_sandbox:create_sandbox_app --factory --host 127.0.0.1 --port 8011
# Never use commerce or customer production data in this service.
ENVIRONMENT=development
PAYMENT_SANDBOX_ENABLED=true
PAYMENT_SANDBOX_ISOLATED=true
PAYMENT_SANDBOX_DATABASE_URL=sqlite:///./cakecity-payment-sandbox.db
# Provision two different random secrets of at least 32 characters; no defaults.
PAYMENT_SANDBOX_ACCESS_TOKEN=
PAYMENT_SANDBOX_WEBHOOK_SECRET=
