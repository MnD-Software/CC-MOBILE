{
  "name": "cakecity-mobile-app",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^5.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.0.0",
    "@tanstack/react-query": "^5.90.0",
    "expo": "~57.0.18",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.13",
    "expo-dev-client": "~57.0.16",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linking": "~57.0.8",
    "expo-location": "~57.0.14",
    "expo-notifications": "~57.0.15",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.62.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "patch-package": "^8.0.1",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:go": "expo start --go --lan",
    "start:usb": "expo start --dev-client --lan",
    "android": "expo run:android",
    "android:device": "expo run:android --device",
    "android:release": "cd android && gradlew.bat assembleRelease",
    "android:release:clean": "cd android && gradlew.bat clean assembleRelease",
    "build:android:apk": "eas build --platform android --profile preview",
    "build:ios:archive": "eas build --platform ios --profile production",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "postinstall": "patch-package"
  },
  "private": true
}
