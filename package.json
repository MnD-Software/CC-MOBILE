{
  "name": "cakecity-mobile-app",
  "version": "0.2.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^5.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.0.0",
    "@tanstack/react-query": "^5.90.0",
    "expo": "~57.0.18",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.13",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.8",
    "expo-location": "~57.0.16",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.22",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.62.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "patch-package": "^8.0.1",
    "prettier": "3.6.2",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "start": "node scripts/expo.cjs start",
    "start:go": "node scripts/expo.cjs start --go --lan",
    "start:usb": "node scripts/expo.cjs start --dev-client --lan",
    "android": "expo run:android",
    "android:device": "expo run:android --device",
    "android:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rebuild-apk.ps1",
    "build:android:apk": "npx eas-cli build --platform android --profile preview",
    "build:ios:archive": "npx eas-cli build --platform ios --profile production",
    "ios": "expo run:ios",
    "web": "node scripts/expo.cjs start --web",
    "export:web": "node scripts/expo.cjs export --platform web --output-dir artifacts/reference-ui/export",
    "verify:ui": "node scripts/verify-reference-ui.cjs",
    "typecheck": "node -r ./scripts/windows-fs.cjs scripts/sync-router-types.cjs && tsc --noEmit",
    "postinstall": "patch-package",
    "test": "node --test tests/*.test.cjs",
    "build:android:aab": "npx eas-cli build --platform android --profile production",
    "release:check": "node scripts/check-release.cjs",
    "format:check": "node -r ./scripts/windows-fs.cjs node_modules/prettier/bin/prettier.cjs --check app src/features src/auth src/api/client.ts src/api/account-commerce.ts src/components/ui/Commerce.tsx src/components/ui/ReferenceArtwork.tsx tests"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  }
}
